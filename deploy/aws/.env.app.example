# App runtime
PORT=8000
OPTIMYSTIC_PYTHON=python3
OPTIMYSTIC_JULIA=julia
OPTIMYSTIC_PYTHON_TIMEOUT_SECONDS=180
OPTIMYSTIC_JULIA_TIMEOUT_SECONDS=180

# Agent loop runtime (Google default)
LLM_PROVIDER=google
MODEL_NAME=gemma-4-26b-a4b-it
FALLBACK_MODEL=gemma-4-26b-a4b-it
GOOGLE_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=EMPTY

# Build metadata
OPTIMYSTIC_IMAGE_TAG=latest
