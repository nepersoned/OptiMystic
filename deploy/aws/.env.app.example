# App runtime
PORT=8000
OPTIMYSTIC_PYTHON=python3
OPTIMYSTIC_JULIA=julia
OPTIMYSTIC_PYTHON_TIMEOUT_SECONDS=180
OPTIMYSTIC_JULIA_TIMEOUT_SECONDS=180

# Agent loop runtime (OpenAI-compatible endpoint; vLLM recommended)
LLM_PROVIDER=openai
MODEL_NAME=google/gemma-4-4b-it
FALLBACK_MODEL=google/gemma-4-4b-it
OPENAI_BASE_URL=http://127.0.0.1:8001/v1
OPENAI_API_KEY=EMPTY

# Build metadata
OPTIMYSTIC_IMAGE_TAG=latest
